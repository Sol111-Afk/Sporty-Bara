<?xml version="1.0" encoding="utf-8"?>
<!-- Ecran 2 — Meci: comparatorul de cote pe case + adăugare pe bilet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:title="La Liga" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/teams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.SportyBara.Title"
                tools:targetApi="28"
                tools:text="Real Madrid – Barcelona" />

            <TextView
                android:id="@+id/kickoff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SportyBara.Small"
                tools:text="Sâm, 22:00" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/odds_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/match_compare"
                        android:textAppearance="@style/TextAppearance.SportyBara.Subtitle" />
                    <!-- rândurile (header + câte unul pe casă) se adaugă din cod -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/match_best_hint"
                android:textAppearance="@style/TextAppearance.SportyBara.Small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/match_add_title"
                android:textAppearance="@style/TextAppearance.SportyBara.Subtitle" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/pick_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <Button
                    android:id="@+id/pick_home"
                    style="@style/Widget.SportyBara.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="1 · 2.40" />

                <Button
                    android:id="@+id/pick_draw"
                    style="@style/Widget.SportyBara.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="X · 3.75" />

                <Button
                    android:id="@+id/pick_away"
                    style="@style/Widget.SportyBara.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="2 · 2.90" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <Button
                android:id="@+id/go_to_ticket"
                style="@style/Widget.SportyBara.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/view_ticket" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
