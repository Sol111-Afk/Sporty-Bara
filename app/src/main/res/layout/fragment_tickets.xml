<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/tab_tickets"
                android:textAppearance="@style/TextAppearance.SportyBara.Title"
                tools:targetApi="28" />

            <TextView
                android:id="@+id/balance"
                style="@style/Widget.SportyBara.CoinPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1000 🍊" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slip_title"
                    android:textAppearance="@style/TextAppearance.SportyBara.Subtitle" />

                <TextView
                    android:id="@+id/slip_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/slip_empty"
                    android:textAppearance="@style/TextAppearance.SportyBara.Body" />

                <LinearLayout
                    android:id="@+id/slip_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/slip_selections"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/stake_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/stake_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stake"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6"
                            android:text="@string/stake_default" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/slip_total_odd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.SportyBara.Number"
                        tools:text="Cotă totală: 5.04" />

                    <TextView
                        android:id="@+id/slip_potential_win"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SportyBara.Win"
                        tools:text="Câștig posibil: 252 🍊" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/slip_clear"
                            style="@style/Widget.SportyBara.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/slip_clear" />

                        <Button
                            android:id="@+id/slip_place"
                            style="@style/Widget.SportyBara.Button.Accent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/slip_place" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/tickets_active"
            android:textAppearance="@style/TextAppearance.SportyBara.Subtitle"
            tools:targetApi="28" />

        <TextView
            android:id="@+id/tickets_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tickets_none"
            android:textAppearance="@style/TextAppearance.SportyBara.Body" />

        <LinearLayout
            android:id="@+id/tickets_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_real_money"
            android:textAppearance="@style/TextAppearance.SportyBara.Small" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
